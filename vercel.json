{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "cv-backend": {
      "root": "cv-backend",
      "framework": "nestjs",
      "functions": {
        "**": {
          "includeFiles": "{**/*.graphql,dist/**/*.graphql,src/**/*.graphql,mail/templates/**/*,dist/mail/templates/**/*}"
        }
      }
    },
    "cv-frontend": {
      "root": "cv-frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "cv-backend",
          "format": "url",
          "env": "CV_BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "cv-frontend"
      }
    }
  ]
}
